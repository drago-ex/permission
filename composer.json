{
	"name": "drago-ex/permission",
	"description": "Lightweight ACL and role management.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"nette/robot-loader": "^4.1",
		"nette/security": "^3.1",
		"nette/application": "^3.2",
		"nette/http": "^3.3",
		"nette/di": "^3.1"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"nette/bootstrap": "^3.1",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-nette": "^2.0",
		"tracy/tracy": "^2.10"
	},
	"suggest": {
		"tracy/tracy": "For the role switch panel in the Tracy bar."
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"bin": [
		"bin/create-permission"
	],
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests/cases -s -C"
	}
}
