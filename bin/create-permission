#!/usr/bin/env php
<?php

declare(strict_types=1);

use Composer\InstalledVersions;
use Nette\PhpGenerator\PhpFile;
use Nette\PhpGenerator\PsrPrinter;

final readonly class CreatePermissionCommand
{
	private const Blue = "\033[34m";
	private const Green = "\033[32m";
	private const Yellow = "\033[33m";
	private const Red = "\033[31m";
	private const Reset = "\033[0m";

	/** Report of the last --packages run, relative to the project root. */
	private const ReportFile = '.drago-project/permission.json';

	/** Keys of a provider definition in permission.php; the first four are required. */
	private const DefinitionKeys = [
		'className', 'namespace', 'resource', 'outputDir',
		'allow', 'allowRole', 'allowPrivilege', 'addResource', 'allowWithResource',
	];

	public function __construct(
		private string $root,
	) {
	}

	public function run(array $argv): int
	{
		$this->requireAutoload();

		$arguments = array_slice($argv, 1);
		if (in_array('--help', $arguments, true) || in_array('-h', $arguments, true)) {
			$this->printHelp();
			return 0;
		}

		['positionals' => $positionals, 'options' => $options] = $this->parseArgs($arguments);
		$force = array_key_exists('force', $options);
		if (array_key_exists('packages', $options)) {
			if ($positionals !== [] || array_diff(array_keys($options), ['packages', 'force']) !== []) {
				$this->error('Use either arguments or --packages, not both.');
				return 1;
			}
			return $this->runPackages($force);
		}

		if (count($positionals) < 2 || count($positionals) > 4) {
			$this->error('Invalid arguments. Run with --help.');
			return 1;
		}

		try {
			$input = $this->buildInput($positionals, $options);
		} catch (InvalidArgumentException $e) {
			$this->error($e->getMessage());
			return 1;
		}

		return $this->generate($input)[0] === 'error' ? 1 : 0;
	}

	/**
	 * Generates the providers that installed packages declare in extra.drago-permission
	 * (a PHP file returning a list of definitions) and writes a report of the run.
	 */
	private function runPackages(bool $force): int
	{
		$entries = [];
		$stats = ['generated' => 0, 'skipped' => 0, 'error' => 0];
		foreach ($this->packageDefinitions() as $package) {
			$entry = ['package' => $package['name'], 'version' => $package['version']];
			if (is_string($package['definitions'])) {
				$this->error("{$package['name']}: {$package['definitions']}");
				$entries[] = $entry + ['action' => 'error', 'message' => $package['definitions']];
				$stats['error']++;
				continue;
			}

			foreach ($package['definitions'] as $i => $definition) {
				try {
					$input = $this->definitionInput($definition, $force);
				} catch (InvalidArgumentException $e) {
					$message = "Definition #$i: {$e->getMessage()}";
					$this->error("{$package['name']}: $message");
					$entries[] = $entry + ['action' => 'error', 'message' => $message];
					$stats['error']++;
					continue;
				}

				// Runs on every composer update in Netis projects, so existing classes are summarized below.
				[$action, $message] = $this->generate($input, warnExisting: false);
				$entries[] = $entry + array_filter([
					'action' => $action,
					'class' => $input->namespaceName . '\\' . $input->className,
					'file' => $this->relativePath($input->outputFile),
					'message' => $message,
				], fn(?string $value): bool => $value !== null);
				$stats[$action]++;
			}
		}

		if ($entries === []) {
			$this->warning('No permission providers found in the installed packages.');
		} elseif ($stats['skipped'] > 0) {
			$this->info("{$stats['skipped']} existing providers kept (use --force to overwrite them).");
		}

		$this->writeReport($force, $stats, $entries);
		return $stats['error'] > 0 ? 1 : 0;
	}

	/**
	 * Installed packages with extra.drago-permission, sorted by name; definitions is an error message
	 * when the file cannot be used.
	 * @return list<array{name: string, version: ?string, definitions: list<mixed>|string}>
	 */
	private function packageDefinitions(): array
	{
		$packages = [];
		$root = realpath($this->root);
		foreach (InstalledVersions::getInstalledPackages() as $name) {
			$path = InstalledVersions::getInstallPath($name);
			$path = $path !== null ? realpath($path) : false;

			// The project itself is the root package; its own providers are written by hand.
			if ($path === false || $path === $root || !is_file("$path/composer.json")) {
				continue;
			}

			$composer = json_decode((string) file_get_contents("$path/composer.json"), true);
			$file = is_array($composer) ? ($composer['extra']['drago-permission'] ?? null) : null;
			if ($file === null) {
				continue;
			}

			$packages[$name] = [
				'name' => $name,
				'version' => InstalledVersions::getPrettyVersion($name),
				'definitions' => $this->loadDefinitions($path, $file),
			];
		}

		ksort($packages);
		return array_values($packages);
	}

	/** @return list<mixed>|string the definitions, or an error message */
	private function loadDefinitions(string $packagePath, mixed $file): array|string
	{
		if (!is_string($file) || $file === '') {
			return 'extra.drago-permission must be a path to a PHP file.';
		}

		$path = $packagePath . DIRECTORY_SEPARATOR . $file;
		if (!is_file($path)) {
			return "Permission file not found: $file";
		}

		$definitions = (static fn(): mixed => require $path)();
		return is_array($definitions) && array_is_list($definitions)
			? $definitions
			: "$file must return a list of provider definitions.";
	}

	/** Converts a definition from permission.php to the same input the command-line arguments give. */
	private function definitionInput(mixed $definition, bool $force): Input
	{
		if (!is_array($definition)) {
			throw new InvalidArgumentException('A definition must be an array.');
		}

		$unknown = array_diff(array_keys($definition), self::DefinitionKeys);
		if ($unknown !== []) {
			throw new InvalidArgumentException('Unknown key ' . implode(', ', $unknown) . '.');
		}

		$positionals = [];
		foreach (['className', 'namespace', 'resource', 'outputDir'] as $key) {
			if (!is_string($definition[$key] ?? null) || $definition[$key] === '') {
				throw new InvalidArgumentException("Missing '$key'.");
			}
			$positionals[] = $definition[$key];
		}

		$options = $force ? ['force' => true] : [];
		foreach (['allowRole' => 'allow-role', 'allowPrivilege' => 'allow-privilege'] as $key => $option) {
			if (isset($definition[$key])) {
				if (!is_string($definition[$key])) {
					throw new InvalidArgumentException("'$key' must be a string.");
				}
				$options[$option] = $definition[$key];
			}
		}

		foreach (['addResource' => 'add-resource', 'allowWithResource' => 'allow-with-resource'] as $key => $option) {
			if (isset($definition[$key])) {
				if (!is_bool($definition[$key])) {
					throw new InvalidArgumentException("'$key' must be true or false.");
				}
				$options[$option] = $definition[$key] ? '1' : '0';
			}
		}

		if (isset($definition['allow'])) {
			$allow = $definition['allow'];
			if (!is_array($allow) || !array_is_list($allow) || array_filter($allow, 'is_string') !== $allow) {
				throw new InvalidArgumentException("'allow' must be a list of rules like 'RoleUser,self::Resource,default'.");
			}
			$options['allow'] = $allow;
		}

		return $this->buildInput($positionals, $options);
	}

	/**
	 * Writes the provider class unless it exists (without --force).
	 * @return array{'generated'|'skipped'|'error', ?string} action and error message
	 */
	private function generate(Input $input, bool $warnExisting = true): array
	{
		if ($input->force === false && is_file($input->outputFile)) {
			if ($warnExisting) {
				$this->warning("File already exists: {$input->outputFile}");
			}
			return ['skipped', null];
		}

		if ($this->ensureDirectory($input->outputDir) === false) {
			return ['error', "Could not create directory: {$this->relativePath($input->outputDir)}"];
		}

		$this->info("Generating {$input->className}...");
		$content = $this->generateClass($input);

		if (file_put_contents($input->outputFile, $content) === false) {
			$this->error("Failed to write file: {$input->outputFile}");
			return ['error', "Failed to write file: {$this->relativePath($input->outputFile)}"];
		}

		$this->success("Permission provider created: {$input->outputFile}");
		return ['generated', null];
	}

	/**
	 * @param array<string, int> $stats
	 * @param list<array<string, ?string>> $entries
	 */
	private function writeReport(bool $force, array $stats, array $entries): void
	{
		$data = [
			'tool' => 'permission',
			'command' => 'create-permission --packages' . ($force ? ' --force' : ''),
			'date' => date('c'),
			'result' => $stats['error'] > 0 ? 'error' : 'ok',
			'stats' => $stats,
			'entries' => $entries,
		];

		$path = $this->root . DIRECTORY_SEPARATOR . self::ReportFile;
		$json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
		if ($json === false || !$this->ensureDirectory(dirname($path)) || file_put_contents($path, $json . "\n") === false) {
			$this->warning('Cannot write report: ' . self::ReportFile);
			return;
		}

		$this->info('Report: ' . self::ReportFile);
	}

	private function relativePath(string $path): string
	{
		$root = rtrim(str_replace('\\', '/', $this->root), '/') . '/';
		$path = str_replace('\\', '/', $path);
		return str_starts_with($path, $root) ? substr($path, strlen($root)) : $path;
	}

	/**
	 * @return array{positionals: list<string>, options: array<string, string|bool|list<string>>}
	 */
	private function parseArgs(array $args): array
	{
		$positionals = [];
		$options = [];

		foreach ($args as $arg) {
			if (str_starts_with($arg, '--')) {
				$raw = substr($arg, 2);
				if ($raw === '') {
					continue;
				}
				[$key, $value] = array_pad(explode('=', $raw, 2), 2, true);
				if ($key === 'allow') {
					$existing = $options[$key] ?? [];
					if (is_string($existing)) {
						$existing = [$existing];
					}
					if (!is_array($existing)) {
						$existing = [];
					}
					$existing[] = (string) $value;
					$options[$key] = $existing;
				} else {
					$options[$key] = $value;
				}
				continue;
			}
			$positionals[] = $arg;
		}

		return ['positionals' => $positionals, 'options' => $options];
	}

	/**
	 * @param list<string> $positionals
	 * @param array<string, string|bool|list<string>> $options
	 */
	private function buildInput(array $positionals, array $options): Input
	{
		$className = $positionals[0];
		$namespaceName = $positionals[1];
		$resource = $positionals[2] ?? ('Backend:' . preg_replace('~Component$~', '', $className));
		$outputDirArg = $positionals[3] ?? 'app/Component';

		$allowRole = $this->stringOption($options, 'allow-role') ?? 'RoleGuest';
		$allowPrivilege = $this->stringOption($options, 'allow-privilege');
		$addResource = $this->boolOption($options, 'add-resource', true);
		$allowWithResource = $this->boolOption($options, 'allow-with-resource', true);
		$allowRules = $this->allowRulesOption($options);
		$force = array_key_exists('force', $options);

		if ($this->isValidClassName($className) === false) {
			throw new InvalidArgumentException("Invalid class name '$className'.");
		}
		if ($this->isValidNamespace($namespaceName) === false) {
			throw new InvalidArgumentException("Invalid namespace '$namespaceName'.");
		}
		if ($this->isValidRoleConstant($allowRole) === false) {
			throw new InvalidArgumentException("Invalid allow role '$allowRole'.");
		}
		foreach ($allowRules as $rule) {
			if ($this->isValidRoleConstant($rule->role) === false) {
				throw new InvalidArgumentException("Invalid allow role '{$rule->role}'.");
			}
		}

		$outputDir = $this->resolveOutputDir($outputDirArg);
		$outputFile = rtrim($outputDir, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . $className . '.php';

		return new Input(
			className: $className,
			namespaceName: $namespaceName,
			resource: $resource,
			outputDir: $outputDir,
			outputFile: $outputFile,
			allowRole: $allowRole,
			allowPrivilege: $allowPrivilege,
			addResource: $addResource,
			allowWithResource: $allowWithResource,
			allowRules: $allowRules,
			force: $force,
		);
	}

	private function generateClass(Input $input): string
	{
		$file = new PhpFile();
		$file->setStrictTypes();

		$namespace = $file->addNamespace($input->namespaceName);
		$namespace->addUse('Drago\\Permission\\Provider');
		$namespace->addUse('Drago\\Permission\\Role');
		$namespace->addUse('Nette\\Security\\Permission');

		$class = $namespace->addClass($input->className);
		$class->setFinal();
		$class->addImplement('Drago\\Permission\\Provider');
		$class->addConstant('Resource', $input->resource)
			->setPrivate()
			->setType('string');

		$register = $class->addMethod('register');
		$register->addParameter('acl')->setType('Nette\\Security\\Permission');
		$register->setReturnType('void');
		$register->setBody($this->buildRegisterBody($input));

		return (new PsrPrinter())->printFile($file);
	}

	private function buildRegisterBody(Input $input): string
	{
		$lines = [];
		if ($input->addResource) {
			$lines[] = '$acl->addResource(self::Resource);';
		}

		if ($input->allowRules !== []) {
			foreach ($input->allowRules as $rule) {
				$resourceArg = $rule->withResource ? ($rule->resource ?? 'self::Resource') : 'null';
				if ($rule->privilege !== null) {
					$lines[] = sprintf(
						'$acl->allow(Role::%s, %s, %s);',
						$rule->role,
						$resourceArg,
						var_export($rule->privilege, true),
					);
				} elseif ($rule->withResource) {
					$lines[] = sprintf('$acl->allow(Role::%s, %s);', $rule->role, $resourceArg);
				} else {
					$lines[] = sprintf('$acl->allow(Role::%s);', $rule->role);
				}
			}
		} else {
			if ($input->allowPrivilege !== null) {
				$privilege = var_export($input->allowPrivilege, true);
				if ($input->allowWithResource) {
					$lines[] = sprintf('$acl->allow(Role::%s, self::Resource, %s);', $input->allowRole, $privilege);
				} else {
					$lines[] = sprintf('$acl->allow(Role::%s, null, %s);', $input->allowRole, $privilege);
				}
			} else {
				if ($input->allowWithResource) {
					$lines[] = sprintf('$acl->allow(Role::%s, self::Resource);', $input->allowRole);
				} else {
					$lines[] = sprintf('$acl->allow(Role::%s);', $input->allowRole);
				}
			}
		}

		return implode("\n", $lines);
	}

	private function ensureDirectory(string $path): bool
	{
		if (is_dir($path)) {
			return true;
		}
		if (@mkdir($path, 0777, true) || is_dir($path)) {
			return true;
		}
		$this->error("Could not create directory: $path");
		return false;
	}

	private function requireAutoload(): void
	{
		$autoload = $this->root . '/vendor/autoload.php';
		if (!is_file($autoload)) {
			$this->error('Composer autoload not found. Run composer install.');
			exit(1);
		}
		require $autoload;
	}

	private function resolveOutputDir(string $outputDirArg): string
	{
		if (str_starts_with($outputDirArg, '/') || preg_match('~^[A-Za-z]:[\\\\/]~', $outputDirArg)) {
			return $outputDirArg;
		}

		return $this->root . DIRECTORY_SEPARATOR . str_replace(['/', '\\'], DIRECTORY_SEPARATOR, $outputDirArg);
	}

	/**
	 * @param array<string, string|bool|list<string>> $options
	 */
	private function stringOption(array $options, string $key): ?string
	{
		$value = $options[$key] ?? null;
		return is_string($value) && $value !== '' ? $value : null;
	}

	/**
	 * @param array<string, string|bool|list<string>> $options
	 */
	private function boolOption(array $options, string $key, bool $default): bool
	{
		if (!array_key_exists($key, $options)) {
			return $default;
		}

		return (string) $options[$key] !== '0';
	}

	/**
	 * @param array<string, string|bool|list<string>> $options
	 * @return list<AllowRule>
	 */
	private function allowRulesOption(array $options): array
	{
		$raw = $options['allow'] ?? [];
		if (is_string($raw)) {
			$raw = [$raw];
		}
		if (!is_array($raw)) {
			return [];
		}

		$rules = [];
		foreach ($raw as $line) {
			$parts = array_map('trim', explode(',', $line));
			$role = $parts[0] ?? '';
			if ($role === '') {
				continue;
			}
			$resource = $parts[1] ?? null;
			$resource = $resource === '' ? null : $resource;
			$privilege = $parts[2] ?? null;
			$privilege = $privilege === '' ? null : $privilege;

			$rules[] = new AllowRule(
				role: $role,
				withResource: $resource !== null,
				resource: $resource,
				privilege: $privilege,
			);
		}

		return $rules;
	}

	private function isValidClassName(string $className): bool
	{
		return (bool) preg_match('~^[A-Z][A-Za-z0-9_]*$~', $className);
	}

	private function isValidNamespace(string $namespace): bool
	{
		return (bool) preg_match('~^[A-Za-z_\\\\][A-Za-z0-9_\\\\]*$~', $namespace);
	}

	private function isValidRoleConstant(string $allowRole): bool
	{
		return (bool) preg_match('~^[A-Za-z_][A-Za-z0-9_]*$~', $allowRole);
	}

	private function printHelp(): void
	{
		echo <<<USAGE
INFO Generate a permission provider class.

Usage:
  create-permission <ClassName> <Namespace> [Resource] [OutputDir] [options]
  create-permission --packages [--force]

With --packages, the providers declared by installed packages are generated: extra.drago-permission
in a package's composer.json points to a PHP file returning a list of definitions with the keys
className, namespace, resource, outputDir, and optionally allow, allowRole, allowPrivilege,
addResource and allowWithResource (the same as the options below). A report of the run is written
to .drago-project/permission.json.

Examples:
  create-permission PermissionProvider App\\Presentation\\Sign Sign app/Presentation/Sign
  create-permission PermissionProvider App\\Modules\\Sign\\Permission Backend:Sign app/Modules/Sign/Permission --allow-role=RoleAdmin
  create-permission PermissionProvider App\\Modules\\Front\\Permission Front:Dashboard app/Modules/Front/Permission --allow-role=RoleUser --allow-privilege=view
  create-permission PermissionProvider App\\Presentation\\Backend\\Admin Backend:Admin app/Presentation/Backend/Admin --allow-role=RoleAdmin --allow-with-resource=0
  create-permission PermissionProvider App\\Presentation\\Backend\\Admin Backend:Admin app/Presentation/Backend/Admin --allow=RoleAdmin --allow=RoleUser,self::Resource,default

Options:
  --allow-role=<RoleConstant>   Default: RoleGuest (example: RoleAdmin)
  --allow-privilege=<string>    Optional privilege for allow()
  --add-resource=<0|1>          Default: 1, whether to generate addResource()
  --allow-with-resource=<0|1>   Default: 1, whether allow() includes self::Resource
  --allow=<rule>                Repeatable. Format: Role | Role,resource | Role,resource,privilege
  --force                       Overwrite existing file
  --packages                    Generate the providers declared by installed packages

USAGE;
	}

	private function info(string $message): void
	{
		fwrite(STDOUT, self::Blue . "INFO $message" . self::Reset . "\n");
	}

	private function success(string $message): void
	{
		fwrite(STDOUT, self::Green . "OK $message" . self::Reset . "\n");
	}

	private function warning(string $message): void
	{
		fwrite(STDERR, self::Yellow . "WARN $message" . self::Reset . "\n");
	}

	private function error(string $message): void
	{
		fwrite(STDERR, self::Red . "ERROR $message" . self::Reset . "\n");
	}
}

final readonly class Input
{
	/**
	 * @param list<AllowRule> $allowRules
	 */
	public function __construct(
		public string $className,
		public string $namespaceName,
		public string $resource,
		public string $outputDir,
		public string $outputFile,
		public string $allowRole,
		public ?string $allowPrivilege,
		public bool $addResource,
		public bool $allowWithResource,
		public array $allowRules,
		public bool $force,
	) {
	}
}

final readonly class AllowRule
{
	public function __construct(
		public string $role,
		public bool $withResource,
		public ?string $resource,
		public ?string $privilege,
	) {
	}
}

$command = new CreatePermissionCommand(getcwd());
exit($command->run($argv));
